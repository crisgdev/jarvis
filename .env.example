# JARVIS - Variables de Entorno
# Copia este archivo como .env y rellena tus API keys

# Google Gemini API (gratis: https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_de_16_caracteres

# Google Calendar (ya configurado con credentials.json)
# No se necesita aqui, el archivo credentials.json esta en la raiz

# Telegram bot (opcional: https://t.me/BotFather para crear un bot)
# TELEGRAM_ALLOWED_USER_IDS: tu id numerico de Telegram (el bot te lo dice al primer /start)
TELEGRAM_BOT_TOKEN=tu_token_del_bot
TELEGRAM_ALLOWED_USER_IDS=

# Wake-on-LAN remoto (opcional): bot separado + MAC usados por wake_listener.py
# en un dispositivo siempre encendido de la LAN. Si TELEGRAM_WOL_BOT_TOKEN esta
# vacio, wake_listener.py usa TELEGRAM_BOT_TOKEN (solo si JARVIS no esta corriendo).
# TELEGRAM_WOL_BOT_TOKEN=
# WOL_MAC=B0:6E:BF:11:1A:4C
# WOL_BROADCAST=192.168.18.255
